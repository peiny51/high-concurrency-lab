# Copy this file to application-local.properties and select the local Spring profile.
# Replace the placeholders with credentials for your own local database.
spring.datasource.url=jdbc:mysql://localhost:3307/concurrency_lab
spring.datasource.username=YOUR_LOCAL_DB_USERNAME
spring.datasource.password=YOUR_LOCAL_DB_PASSWORD

# Local lab conveniences, not production schema migration or logging settings.
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true

spring.data.redis.host=localhost
spring.data.redis.port=6379
spring.kafka.bootstrap-servers=localhost:9092
